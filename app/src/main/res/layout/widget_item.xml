<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_row_height"
    android:layout_marginStart="2dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="1dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/widget_item_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="8dp">

    <!--
      The tap target for ticking a todo is the whole 44x48dp box; only the glyph inside is small.
      Most of the mis-taps reported on the home screen came from this view being 18dp wide.
    -->
    <ImageView
        android:id="@+id/widget_item_icon"
        android:layout_width="@dimen/widget_tick_size"
        android:layout_height="@dimen/widget_row_height"
        android:contentDescription="@null"
        android:padding="@dimen/widget_tick_glyph_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_todo_open" />

    <!-- Exactly one line: the widget shows what is on the list, never when it was touched. -->
    <TextView
        android:id="@+id/widget_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textSize="14sp" />
</LinearLayout>
