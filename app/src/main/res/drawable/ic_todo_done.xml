<?xml version="1.0" encoding="utf-8"?>
<!--
  The done circle, ticked. Line art rather than a filled disc with a knocked-out check: a single
  colour means the widget can tint it from the palette, and it keeps the row's visual weight the
  same whether the todo is done or not.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M12,12 m-8.6,0 a8.6,8.6 0 1,0 17.2,0 a8.6,8.6 0 1,0 -17.2,0"
        android:strokeColor="@color/ink_faint"
        android:strokeWidth="1.45" />
    <path
        android:pathData="M8,12.3 L10.8,15 L16.2,9.4"
        android:strokeColor="@color/ink_faint"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.45" />
</vector>
