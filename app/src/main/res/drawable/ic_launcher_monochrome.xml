<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon (Android 13+) layer. Only the alpha channel is used — the system tints it, so every
  path is white and colour is meaningless here.

  Deliberately NOT the same outline as the foreground: Android renders this mark on a background
  the system picks, so the two soil lobes would have nothing to contrast against and the 5-unit
  V-gap would collapse into a stray 1-unit notch. Merging them back into one mound keeps a clean,
  readable silhouette at themed-icon sizes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- one solid mound instead of the split lobes -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M34,79 C34,71 42,67 54,67 C66,67 74,71 74,79 Z" />
    <path
        android:fillColor="#00000000"
        android:pathData="M54,79 C53,68 53,57 54,46"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="4.4" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,46 C44,47 37,39 37,29 C47,29 54,36 54,46 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,46 C64,47 71,39 71,29 C61,29 54,36 54,46 Z" />
</vector>
