<?xml version="1.0" encoding="utf-8"?>
<!--
  NOTE ON THE FILENAME. The "_v2" is load-bearing, not tidiness.

  AppWidgetHostView.inflateAsync() recycles the existing view tree when the incoming RemoteViews
  has the same layout id (`remoteViews.canRecycleView(mView)` compares exactly that). A change to
  a layout's *content* therefore never reaches a widget that is already on someone's home screen —
  the host keeps the tree it inflated the first time and only replays the actions.

  COLOURS. Every android:textColor / android:src tint in this file is only an inflation default.
  The launcher inflates this layout with ITS configuration, so `@color/ink` here follows the
  *system* night mode, not the app's theme setting — the two can disagree, and when they do the
  text is painted for the wrong background. Anything that must follow the app's theme has to be
  assigned in WidgetRenderer from BitSayPalette. Check that before adding a view.

  Renaming the file gives it a new resource id, which is the one thing that forces a real
  re-inflate. Without that, a layout change has no effect at all on a widget already on a home
  screen. Bumped to _v3 when the empty state gained its plant and two lines of text — **any future
  change to this file's attributes needs another bump**, while runtime-applied colours and
  drawables do not.
-->
<!--
  Widget layout:
    [ 笔记 | 待办 ]  (open app)     ← two tabs instead of a toggle button, plus a way into the app
    ┌───────────────────────────┐
    │ scrolling list of one-line rows │
    └───────────────────────────┘
                              ( + )   ← floating, bottom-right, mirrors the app's own FAB
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
          Header: the way into the app sits on the left, search on the right, the two list tabs
          between them — the two icon buttons are symmetric about the tabs, search on the right.

          Always visible. It used to be hidden below three rows of content, but the widget's minimum
          is 3x3 now, so there is no size left at which it would be dropped.
        -->
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_open_app"
                android:layout_width="@dimen/widget_button_size"
                android:layout_height="@dimen/widget_button_size"
                android:contentDescription="@string/widget_open_app"
                android:padding="@dimen/widget_button_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_open_app" />

            <TextView
                android:id="@+id/widget_tab_notes"
                android:layout_width="0dp"
                android:layout_height="@dimen/widget_tab_height"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tab_bg"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/tab_notes"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_tab_todos"
                android:layout_width="0dp"
                android:layout_height="@dimen/widget_tab_height"
                android:layout_weight="1"
                android:background="@drawable/widget_tab_bg"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/tab_todos"
                android:textColor="@color/ink_soft"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_search"
                android:layout_width="@dimen/widget_button_size"
                android:layout_height="@dimen/widget_button_size"
                android:contentDescription="@string/widget_search"
                android:padding="@dimen/widget_button_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_search" />
        </LinearLayout>

        <!--
          The + button floats *over* the list (it is the later child of the FrameLayout), so the
          list keeps no reserved gap at the bottom: clipToPadding=false lets rows scroll all the
          way down, and the button simply sits on top of the last one.
        -->
        <!--
          The orange ring around the pressed row is THIS view's listSelector.

          AbsListView takes it from its own layout attributes
          (AbsListView.java:986 `a.getDrawable(R.styleable.AbsListView_listSelector)`) and paints it
          over the pressed item in positionSelectorLikeTouch(). Leaving the attribute out does not
          mean "no selector" — it falls back to the theme's `?android:attr/listSelector`, which on
          this device is an orange rounded stroke.

          Transparent, not @null: `@null` resolves to a null Drawable, and AbsListView only calls
          setSelector() when the resolved value is non-null
          (`if (selector != null) setSelector(selector);`), leaving mSelector at whatever the theme
          style put there. A transparent ColorDrawable is non-null, so it always wins.
        -->
        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:fadeScrollbars="true"
            android:listSelector="@android:color/transparent"
            android:paddingTop="2dp"
            android:paddingEnd="3dp"
            android:paddingBottom="2dp"
            android:scrollbarDefaultDelayBeforeFade="1200"
            android:scrollbarFadeDuration="500"
            android:scrollbarSize="3dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbarThumbVertical="@drawable/widget_scrollbar"
            android:scrollbarTrackVertical="@android:color/transparent"
            android:scrollbars="vertical" />

        <!--
          Empty state: the same three parts the app's EmptyState shows — the plant, a title, a hint.
          It used to be one centred line of text, which made the widget look like it had failed to
          load rather than like it was simply waiting for a first entry.

          The plant is a vector rather than a drawing: RemoteViews cannot run custom drawing code.
          Its size is fixed at what fits the 3x3 minimum, so there is no size-dependent branch here.
        -->
        <LinearLayout
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_empty_sprout"
                android:layout_width="@dimen/widget_empty_sprout"
                android:layout_height="@dimen/widget_empty_sprout"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_sprout" />

            <TextView
                android:id="@+id/widget_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_empty_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:maxLines="2"
                android:textColor="@color/ink_soft"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_add"
        android:layout_width="@dimen/widget_fab_size"
        android:layout_height="@dimen/widget_fab_size"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/widget_fab_bg"
        android:contentDescription="@string/action_new"
        android:padding="@dimen/widget_fab_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_add" />
</FrameLayout>
