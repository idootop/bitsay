# bitsay 签名配置模板
#
# 用法：
#   cp keystore.properties.example keystore.properties
#   然后把下面的值换成真实口令（真实文件已被 .gitignore 挡住，不会入库）
#
# 这里填的是相对项目根目录的路径。
# 不知道口令？去找你备份 keystore/ 时一起存下来的那份 keystore.properties。

storeFile=keystore/bitsay-release.jks
storePassword=CHANGE_ME
keyAlias=bitsay
keyPassword=CHANGE_ME
