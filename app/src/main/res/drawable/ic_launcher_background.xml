<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: flat ink.

  Deliberately a single flat colour and nothing else. The old icon drew a yellow field with two
  hand-drawn squiggles in it; at 48dp those squiggles read as dirt, and at 24dp as noise. The
  mark is now carried entirely by the foreground.

  Ink (#17140F) is the icon's own value, not the in-app paper/ink pair — a launcher icon lives on
  the wallpaper, not inside the app, so it must not follow the app's light/dark scheme.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF17140F"
        android:pathData="M0,0h108v108h-108z" />
</vector>
