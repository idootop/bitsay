<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: 破土 (breaking through) — the chosen mark.

  Two soil lobes pushed apart by the stem, with a bright seedling growing out of the gap.
  Geometry is copied verbatim from the design board's spec (design/js/appicon.js, variant C5);
  if the mark changes there, change it here in the same commit.

    soil lobes  fill   #2C4A35
    stem        stroke #7FC98F, width 4.4, round cap
    leaves      fill   #7FC98F

  Canvas is 108x108 with the safe zone a circle of radius 33 about (54,54). The furthest point
  of this artwork is 32.0 (the lobes' outer bottom corners), so no mask clips it.

  These greens are icon-only values: they are tuned to sit on ink. The in-app "leaf" colour is
  muted sage and would disappear here.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- soil, split by the stem — the gap is a V: 5 wide at the base, 10 wide at the top -->
    <path
        android:fillColor="#FF2C4A35"
        android:pathData="M34,79 C34,71 41,67 50,66 L52.5,79 Z" />
    <path
        android:fillColor="#FF2C4A35"
        android:pathData="M57.5,79 L60,66 C69,67 74,71 74,79 Z" />
    <!-- stem -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,79 C53,68 53,57 54,46"
        android:strokeColor="#FF7FC98F"
        android:strokeLineCap="round"
        android:strokeWidth="4.4" />
    <!-- the two leaves meet at one node (54,46): a seedling, not a vine -->
    <path
        android:fillColor="#FF7FC98F"
        android:pathData="M54,46 C44,47 37,39 37,29 C47,29 54,36 54,46 Z" />
    <path
        android:fillColor="#FF7FC98F"
        android:pathData="M54,46 C64,47 71,39 71,29 C61,29 54,36 54,46 Z" />
</vector>
