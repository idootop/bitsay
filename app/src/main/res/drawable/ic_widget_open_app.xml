<?xml version="1.0" encoding="utf-8"?>
<!--
  "Open the app". Deliberately the same note-and-tick motif as the launcher icon, so the button
  reads as "比特记 itself" rather than as a generic arrow or menu glyph.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- note card -->
    <path
        android:fillColor="#00000000"
        android:pathData="M5,4.2 L14.6,4.2 A1.8,1.8 0 0 1 16.4,6 L16.4,12.6 A1.8,1.8 0 0 1 14.6,14.4 L5,14.4 A1.8,1.8 0 0 1 3.2,12.6 L3.2,6 A1.8,1.8 0 0 1 5,4.2 Z"
        android:strokeColor="#3D3A38"
        android:strokeWidth="1.8" />
    <!-- ruled lines -->
    <path
        android:pathData="M6,7.6 L13.6,7.6"
        android:strokeColor="#3D3A38"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />
    <path
        android:pathData="M6,10.8 L11.4,10.8"
        android:strokeColor="#3D3A38"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />
    <!-- tick badge -->
    <path
        android:fillColor="#7ED0A0"
        android:pathData="M16.4,16.2 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:strokeColor="#3D3A38"
        android:strokeWidth="1.6" />
    <path
        android:pathData="M14,16.3 L15.7,18.1 L19.1,14.1"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.9" />
</vector>
