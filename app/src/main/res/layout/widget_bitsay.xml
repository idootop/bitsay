<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget layout:
    [ 笔记 | 待办 ]  (open app)     ← two tabs instead of a toggle button, plus a way into the app
    ┌───────────────────────────┐
    │ scrolling list of one-line rows │
    └───────────────────────────┘
                              ( + )   ← floating, bottom-right, mirrors the app's own FAB
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
          Header: the way into the app sits on the left, search on the right, the two list tabs
          between them — the two icon buttons are symmetric about the tabs, search on the right.
        -->
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_open_app"
                android:layout_width="@dimen/widget_button_size"
                android:layout_height="@dimen/widget_button_size"
                android:contentDescription="@string/widget_open_app"
                android:padding="@dimen/widget_button_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_open_app" />

            <TextView
                android:id="@+id/widget_tab_notes"
                android:layout_width="0dp"
                android:layout_height="@dimen/widget_tab_height"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tab_bg"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/tab_notes"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_tab_todos"
                android:layout_width="0dp"
                android:layout_height="@dimen/widget_tab_height"
                android:layout_weight="1"
                android:background="@drawable/widget_tab_bg"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/tab_todos"
                android:textColor="@color/ink_soft"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_search"
                android:layout_width="@dimen/widget_button_size"
                android:layout_height="@dimen/widget_button_size"
                android:contentDescription="@string/widget_search"
                android:padding="@dimen/widget_button_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_search" />
        </LinearLayout>

        <!--
          The + button floats *over* the list (it is the later child of the FrameLayout), so the
          list keeps no reserved gap at the bottom: clipToPadding=false lets rows scroll all the
          way down, and the button simply sits on top of the last one.
        -->
        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:fadeScrollbars="true"
            android:paddingTop="2dp"
            android:paddingEnd="3dp"
            android:paddingBottom="2dp"
            android:scrollbarDefaultDelayBeforeFade="1200"
            android:scrollbarFadeDuration="500"
            android:scrollbarSize="3dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbarThumbVertical="@drawable/widget_scrollbar"
            android:scrollbarTrackVertical="@android:color/transparent"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/widget_empty"
            android:textColor="@color/ink_soft"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_add"
        android:layout_width="@dimen/widget_fab_size"
        android:layout_height="@dimen/widget_fab_size"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/widget_fab_bg"
        android:contentDescription="@string/action_new"
        android:padding="@dimen/widget_fab_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_add" />
</FrameLayout>
