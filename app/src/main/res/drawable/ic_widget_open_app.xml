<?xml version="1.0" encoding="utf-8"?>
<!--
  "Open the app", drawn the way the empty state draws its plant: **outline only**, two leaves on one
  stem. Replaces the filled 破土 mark that used to sit here — this button is chrome, and its
  neighbour is the search icon, a 2px stroked magnifier. A solid two-tone badge beside it read as a
  sticker glued onto the bar.

  Proportions are deliberately leafier than design/js/sprout.js: the node sits at y=46 rather than
  y=36, so the stem is shorter and the two leaves are wider. At 18dp in the widget bar the taller
  version read as a thin stalk with a bud on top rather than as a sprout.

  Scaled from its own 64x88 space into 24 with 2 units of margin. The stroke stays at 2 viewBox
  units (it is not scaled with the geometry) so it renders at the same weight as ic_widget_search.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M12,22 C11.7,17.76 11.7,14.12 12,10.48"
        android:strokeColor="@color/icon_ink"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:fillColor="#00000000"
        android:pathData="M12,10.48 C8.36,10.79 4.73,7.45 4.73,2 C8.97,2 12,5.64 12,10.48 Z"
        android:strokeColor="@color/icon_ink"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:fillColor="#00000000"
        android:pathData="M12,10.48 C15.64,10.79 19.27,7.45 19.27,2 C15.03,2 12,5.64 12,10.48 Z"
        android:strokeColor="@color/icon_ink"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
